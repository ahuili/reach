cask "reach" do
  version "{{VERSION}}"
  sha256 "{{SHA256}}"

  url "https://github.com/{{OWNER}}/{{REPO}}/releases/download/v#{version}/Reach-#{version}.zip"
  name "Reach"
  name "手边"
  desc "Edge sidebar for clipboard history, kept notes and secrets, with agent access"
  homepage "https://github.com/{{OWNER}}/{{REPO}}"

  livecheck do
    url :url
    strategy :github_latest
  end

  depends_on macos: :sonoma

  app "Reach.app"
  binary "#{appdir}/Reach.app/Contents/MacOS/reachctl", target: "reach"

  # 还没有 Apple 公证：去掉隔离标记，否则 macOS 会拦着不让打开
  reach_app = "#{appdir}/Reach.app"
  postflight_steps do
    run "/usr/bin/xattr", args: ["-dr", "com.apple.quarantine", reach_app], must_succeed: false
  end

  uninstall quit: "{{BUNDLE_ID}}"

  zap trash: [
    "~/Library/Application Support/Reach",
    "~/Library/Caches/Reach",
    "~/Library/Preferences/{{BUNDLE_ID}}.plist",
  ]

  caveats <<~EOS
    回车直接贴进当前窗口需要「辅助功能」权限：系统设置 › 隐私与安全性 › 辅助功能 里打开「手边 / Reach」。
    不开也能用，只是贴的时候要自己按 ⌘V。
  EOS
end
