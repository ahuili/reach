# 发布相关的信息，改这里一处即可
GITHUB_OWNER="${GITHUB_OWNER:-ahuili}"
GITHUB_REPO="${GITHUB_REPO:-reach}"
TAP_REPO="${TAP_REPO:-homebrew-tap}"
BUNDLE_ID="${BUNDLE_ID:-me.ahuili.reach}"
# 签名用的证书。钥匙串里有这张自签名证书就用它：签名身份固定，重新构建、升级后
# 钥匙串和辅助功能的授权都不会失效。作者本机和 Weft 共用一张。
# 自己从源码构建：运行 scripts/make-cert.sh 建一张，或把这里改成你已有的代码签名证书。
SIGN_IDENTITY="${SIGN_IDENTITY:-Weft Local Signing}"
